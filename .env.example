# mapasmn. Single source of truth for all submodule env vars.
# Copy to `.env` (auto-done by `make setup`); per-submodule .env files are
# generated from this one via `scripts/setup-env.sh`. Do not edit submodule
# .env files directly because they get overwritten.

# Shared
APP_ENV=development
LOG_LEVEL=INFO
# Legacy name retained for compatibility: shared internal-service password,
# including in production (SeaweedFS, RabbitMQ, Pushgateway, Redis, bundled
# MySQL and station admin). External MySQL and SMN API use separate credentials.
# It is interpolated into commands and SQL: no spaces,
# quotes or `$`. Generate one with
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
DEV_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Cross-service S3 / SeaweedFS (provisioned by tiles-processor, consumed by data-service & alerts-service)
S3_TILES_DATA_PORT=9000
S3_TILES_DATA_BUCKET_NAME=tiles-data
S3_ROOT_USER=root_admin
S3_TILES_DATA_TILES_PROCESSOR_USER=tiles_processor
S3_TILES_DATA_DATA_SERVICE_USER=data_service
S3_INTERSECTION_DATA_BUCKET_NAME=intersection-data
S3_INTERSECTION_DATA_ALERTS_SERVICE_USER=alerts_service
S3_BASEMAP_BUCKET_NAME=basemap-tiles

# Credentials for raw-data buckets. They are used only when the corresponding
# source has input.mode=s3. Leave both values empty for anonymous access.
GOES19_ABI_S3_ACCESS_KEY=
GOES19_ABI_S3_SECRET_KEY=
GOES19_GLM_S3_ACCESS_KEY=
GOES19_GLM_S3_SECRET_KEY=
RADAR_SINARAME_S3_ACCESS_KEY=
RADAR_SINARAME_S3_SECRET_KEY=
RADAR_INTA_S3_ACCESS_KEY=
RADAR_INTA_S3_SECRET_KEY=
WRF_ARG4K_S3_ACCESS_KEY=
WRF_ARG4K_S3_SECRET_KEY=
ECMWF_IFS_S3_ACCESS_KEY=
ECMWF_IFS_S3_SECRET_KEY=
GFS_S3_ACCESS_KEY=
GFS_S3_SECRET_KEY=

# All directory variable names are listed for reference. Uncomment only the
# sources configured as local in settings-beta-1.json and add their read-only
# mount to the Beta-1 compose. Paths must be absolute and directories must exist
# before Docker Compose starts.
# Current Beta-1 also mounts RADAR_INTA_INPUT_DIR even though INTA is disabled
# in settings-beta-1.json: set it to an existing directory until that mount is
# removed upstream. The production configuration uses all four local inputs.
# GOES19_ABI_INPUT_DIR=/srv/mapasmn/input/goes19-abi
# GOES19_GLM_INPUT_DIR=/srv/mapasmn/input/goes19-glm
# RADAR_SINARAME_INPUT_DIR=/srv/mapasmn/input/radar-sinarame
# RADAR_INTA_INPUT_DIR=/srv/mapasmn/input/radar-inta
# WRF_ARG4K_INPUT_DIR=/srv/mapasmn/input/wrf-arg4k
# ECMWF_IFS_INPUT_DIR=/srv/mapasmn/input/ecmwf-ifs
# GFS_INPUT_DIR=/srv/mapasmn/input/gfs

# data-service
DATA_SERVICE_APP_HOST_PORT=6006
DATA_SERVICE_WEB_CONCURRENCY=3
DATA_SERVICE_SYNC_INTERVAL_SECONDS=60
REDIS_URL=redis://redis:6379/0
S3_WEATHER_STATIONS_BUCKET_NAME=weather-stations-data

# Selectable base maps. data-service requires a URL for every enabled XYZ
# provider; leaving one empty removes that provider and its S3 fallback.
# Values are quoted because setup-env.sh sources this file and the Google URL
# contains shell metacharacters.
BASEMAP_ARGENMAP_URL='https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/capabaseargenmap@EPSG%3A3857@png/{z}/{x}/{y}.png'
BASEMAP_ARGENMAPGRIS_URL='https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/mapabase_gris@EPSG%3A3857@png/{z}/{x}/{y}.png'
BASEMAP_ARGENMAPOSCURO_URL='https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/argenmap_oscuro@EPSG%3A3857@png/{z}/{x}/{y}.png'
BASEMAP_ARGENMAPTOPOGRAFICO_URL='https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/mapabase_topo@EPSG%3A3857@png/{z}/{x}/{y}.png'
BASEMAP_SATELLITE_URL='https://server.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
BASEMAP_TOPOGRAPHIC_URL='https://server.arcgisonline.com/ArcGIS/rest/services/World_Physical_Map/MapServer/tile/{z}/{y}/{x}'
BASEMAP_GOOGLESATELLITE_URL='https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}'
BASEMAP_OCEANBASE_URL='https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}'

# Development/test endpoint. Replace it with the SMN operational endpoint when
# Beta-1 is connected to the live station feed.
SMN_API_BASE_URL=https://api-test.smn.gob.ar/v1
SMN_API_USERNAME=
SMN_API_PASSWORD=
SMN_API_TOKEN_SETTLING_DELAY_SECONDS=0
SMN_API_LOG_REQUESTS=false
SMN_STATIONS_REGISTRY_URL=http://ssl.smn.gob.ar/dpd/zipopendata.php?dato=estaciones

# alerts-service
ALERTS_SERVICE_APP_HOST_PORT=6007
# Host folder containing trama_smn.png, supplied separately by email.
# Relative paths resolve under alerts-service/; absolute paths are recommended.
WATERMARK_DIR=./data_alerts
# `make prod`: true starts the included MySQL; false uses an external server
# and requires MANAGE_DB_SCHEMAS=false and explicit database credentials.
MYSQL_BUNDLED_MODE=true
MYSQL_DATABASE=aviso_gempak
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_HOST=localhost
MYSQL_USER=alerts_service
# Required for external MySQL. Bundled MySQL keeps using DEV_PASSWORD.
MYSQL_PASSWORD=
MYSQL_READONLY_USER=avisos
MYSQL_READONLY_MAX_CONNECTIONS=50
MYSQL_READONLY_MAX_CONNECTIONS_PER_HOUR=10000
MANAGE_DB_SCHEMAS=true

# Separate read connection for the institutional taviso table. Empty values
# inherit MYSQL_* / the readonly account during setup (Beta-1 behavior).
# External MySQL requires MYSQL_TAVISO_USER and MYSQL_TAVISO_PASSWORD explicitly;
# host, port and database can inherit the write connection.
MYSQL_TAVISO_HOST=
MYSQL_TAVISO_PORT=
MYSQL_TAVISO_DATABASE=
MYSQL_TAVISO_USER=
MYSQL_TAVISO_PASSWORD=

# Optional geographic-layer S3 backup for alerts-service (empty = disabled).
# In production, seaweedfs:8333 is reachable over Docker DNS.
ALERTS_S3_ENDPOINT=
ALERTS_S3_ACCESS_KEY=
ALERTS_S3_SECRET_KEY=
ALERTS_S3_BUCKET_NAME=
ALERTS_S3_SECURE=true

# tiles-processor, SeaweedFS metrics
SEAWEEDFS_METRICS_ADDRESS=
PROMETHEUS_PUSHGATEWAY_HTTP_PROTO=http
PROMETHEUS_PUSHGATEWAY_USER=push_user

# tiles-processor, RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=tiles_processor
RABBITMQ_QUEUE=tiles_work_queue
RABBITMQ_RADAR_LIGHT_QUEUE=tiles_radar_light_queue
RABBITMQ_WRF_LIGHT_QUEUE=tiles_wrf_light_queue
RABBITMQ_DLQ=tiles_dead_letter_queue
RABBITMQ_DLX=tiles_dlx

# tiles-processor, workers
# Mapped to WORKER_CONCURRENCY / S3_UPLOAD_CONCURRENCY in tiles-processor only.
TILES_PROCESSOR_WORKER_CONCURRENCY=2
TILES_PROCESSOR_S3_UPLOAD_CONCURRENCY=32
JOB_TTL_MINUTES=20
GDAL_CACHEMAX=128
CPL_VSIL_CURL_CACHE_SIZE=16777216
METRICS_API_PORT=6020
METRICS_API_KEY=
ECMWF_TP_SMOOTHING_RESOLUTION_DEG=0.01
ECMWF_OPENDATA_SOURCES=ecmwf,azure,aws
GFS_SUBSET_ENDPOINT=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
GFS_TILE_SMOOTHING_RESOLUTION_DEG=0.01

# visualizer
# These URLs are compiled into the browser application. For a VM deployment,
# replace localhost with public or private addresses reachable by its users.
VISUALIZER_APP_HOST_PORT=6010
DOCS_URL=/docs-site
DATA_SERVICE_BASE_URL=http://localhost:6006
ALERTS_SERVICE_BASE_URL=http://localhost:6007
SMN_API_PROMPT_FOR_TOKEN=true
METRICS_SERVICE_BASE_URL=http://localhost:6020
IGN_PLACE_SEARCH_URL=https://api.ign.gob.ar/buscador/search
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
