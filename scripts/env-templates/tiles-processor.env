LOG_LEVEL=${LOG_LEVEL}

DATA_DIR=/app/data

# Ports
S3_TILES_DATA_PORT=${S3_TILES_DATA_PORT}

# S3 Root Configuration (Internal Admin)
S3_ROOT_USER=${S3_ROOT_USER}
S3_ROOT_PASSWORD=${DEV_PASSWORD}

# S3 Tiles Data Configuration
S3_TILES_DATA_ENDPOINT=seaweedfs:8333
S3_TILES_DATA_BUCKET_NAME=${S3_TILES_DATA_BUCKET_NAME}
S3_TILES_DATA_SECURE=false

S3_TILES_DATA_TILES_PROCESSOR_USER=${S3_TILES_DATA_TILES_PROCESSOR_USER}
S3_TILES_DATA_TILES_PROCESSOR_PASSWORD=${DEV_PASSWORD}
S3_TILES_DATA_DATA_SERVICE_USER=${S3_TILES_DATA_DATA_SERVICE_USER}
S3_TILES_DATA_DATA_SERVICE_PASSWORD=${DEV_PASSWORD}

# S3 Intersection Data Configuration (alerts-service geojson layers)
S3_INTERSECTION_DATA_BUCKET_NAME=${S3_INTERSECTION_DATA_BUCKET_NAME}
S3_INTERSECTION_DATA_ALERTS_SERVICE_USER=${S3_INTERSECTION_DATA_ALERTS_SERVICE_USER}
S3_INTERSECTION_DATA_ALERTS_SERVICE_PASSWORD=${DEV_PASSWORD}

# Basemap bucket (consumed by data-service)
S3_BASEMAP_BUCKET_NAME=${S3_BASEMAP_BUCKET_NAME}

# Optional input-bucket credentials. A source in S3 mode accepts either both
# values or neither one.
GOES19_ABI_S3_ACCESS_KEY=${GOES19_ABI_S3_ACCESS_KEY}
GOES19_ABI_S3_SECRET_KEY=${GOES19_ABI_S3_SECRET_KEY}
GOES19_GLM_S3_ACCESS_KEY=${GOES19_GLM_S3_ACCESS_KEY}
GOES19_GLM_S3_SECRET_KEY=${GOES19_GLM_S3_SECRET_KEY}
RADAR_SINARAME_S3_ACCESS_KEY=${RADAR_SINARAME_S3_ACCESS_KEY}
RADAR_SINARAME_S3_SECRET_KEY=${RADAR_SINARAME_S3_SECRET_KEY}
WRF_ARG4K_S3_ACCESS_KEY=${WRF_ARG4K_S3_ACCESS_KEY}
WRF_ARG4K_S3_SECRET_KEY=${WRF_ARG4K_S3_SECRET_KEY}
ECMWF_IFS_S3_ACCESS_KEY=${ECMWF_IFS_S3_ACCESS_KEY}
ECMWF_IFS_S3_SECRET_KEY=${ECMWF_IFS_S3_SECRET_KEY}
GFS_S3_ACCESS_KEY=${GFS_S3_ACCESS_KEY}
GFS_S3_SECRET_KEY=${GFS_S3_SECRET_KEY}

# Host paths for the sources that use local mode in settings-beta-1.json.
GOES19_GLM_INPUT_DIR=${GOES19_GLM_INPUT_DIR}
RADAR_SINARAME_INPUT_DIR=${RADAR_SINARAME_INPUT_DIR}
WRF_ARG4K_INPUT_DIR=${WRF_ARG4K_INPUT_DIR}

# SeaweedFS metrics. Leave SEAWEEDFS_METRICS_ADDRESS empty to disable the Pushgateway.
SEAWEEDFS_METRICS_ADDRESS=${SEAWEEDFS_METRICS_ADDRESS}
PROMETHEUS_PUSHGATEWAY_HTTP_PROTO=${PROMETHEUS_PUSHGATEWAY_HTTP_PROTO}
PROMETHEUS_PUSHGATEWAY_USER=${PROMETHEUS_PUSHGATEWAY_USER}
PROMETHEUS_PUSHGATEWAY_PASS=${DEV_PASSWORD}

RABBITMQ_PORT=${RABBITMQ_PORT}
RABBITMQ_MGMT_PORT=${RABBITMQ_MGMT_PORT}
RABBITMQ_USER=${RABBITMQ_USER}
RABBITMQ_PASSWORD=${DEV_PASSWORD}
RABBITMQ_QUEUE=${RABBITMQ_QUEUE}
RABBITMQ_RADAR_LIGHT_QUEUE=${RABBITMQ_RADAR_LIGHT_QUEUE}
RABBITMQ_WRF_LIGHT_QUEUE=${RABBITMQ_WRF_LIGHT_QUEUE}
RABBITMQ_DLQ=${RABBITMQ_DLQ}
RABBITMQ_DLX=${RABBITMQ_DLX}

# Status metrics API
METRICS_API_PORT=${METRICS_API_PORT}
METRICS_API_KEY=${METRICS_API_KEY}

# Numerical-model sources and rendering
ECMWF_TP_SMOOTHING_RESOLUTION_DEG=${ECMWF_TP_SMOOTHING_RESOLUTION_DEG}
ECMWF_OPENDATA_SOURCES=${ECMWF_OPENDATA_SOURCES}
GFS_SUBSET_ENDPOINT=${GFS_SUBSET_ENDPOINT}
GFS_TILE_SMOOTHING_RESOLUTION_DEG=${GFS_TILE_SMOOTHING_RESOLUTION_DEG}

JOB_TTL_MINUTES=${JOB_TTL_MINUTES}

GDAL_CACHEMAX=${GDAL_CACHEMAX}
CPL_VSIL_CURL_CACHE_SIZE=${CPL_VSIL_CURL_CACHE_SIZE}
